[Unit]
Description=CogTrap receiver (rootless container)
Requires=cogtrap-receiver.service
After=network-online.target cogtrap-receiver.service
Wants=network-online.target

[Service]
Type=simple
User=cogtrap
Group=cogtrap
Environment=XDG_RUNTIME_DIR=/run/user/994
Environment=HOME=/home/cogtrap
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ExecStart=/usr/bin/podman run --rm --name cogtrap-receiver \
  --read-only --tmpfs /tmp:rw,size=16m --cap-drop=ALL \
  --security-opt no-new-privileges \
  --user 0:0 \
  --network host \
  -v /data/cogtrap/receiver:/app/instance:Z \
  -w /opt/cogtrap --entrypoint python3 localhost/cogtrap:latest /opt/cogtrap/tools/soc_receiver.py --listen 127.0.0.1:8898 --out /app/instance/alerts.jsonl
ExecStop=/bin/sh -c '/usr/bin/podman stop -t 5 cogtrap-receiver 2>/dev/null || true'
MemoryMax=768M
TasksMax=320
KillMode=mixed
TimeoutStopSec=25

[Install]
WantedBy=multi-user.target
