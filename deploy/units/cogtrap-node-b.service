[Unit]
Description=CogTrap node-b (rootless container)
Requires=cogtrap-receiver.service
After=network-online.target cogtrap-receiver.service
Wants=network-online.target

[Service]
Type=simple
User=cogtrap
Group=cogtrap
Environment=XDG_RUNTIME_DIR=/run/user/994
Environment=HOME=/home/cogtrap
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ExecStart=/usr/bin/podman run --rm --name cogtrap-node-b \
  --read-only --tmpfs /tmp:rw,size=16m --cap-drop=ALL \
  --security-opt no-new-privileges \
  --user 0:0 \
  --network host \
  -v /data/cogtrap/node-b:/app/instance:Z \
  -w /opt/cogtrap localhost/cogtrap:latest --config /app/instance/config.json serve --instance /app/instance/instance.json --scenario /app/instance/scenario.json
ExecStop=/bin/sh -c '/usr/bin/podman stop -t 5 cogtrap-node-b 2>/dev/null || true'
MemoryMax=768M
TasksMax=320
KillMode=mixed
TimeoutStopSec=25

[Install]
WantedBy=multi-user.target
